rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One save document per user, at users/{uid}. Only that user's own
    // signed-in session (anonymous or otherwise) can read/write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
