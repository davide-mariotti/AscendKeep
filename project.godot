; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-5907544153918240~2079014752"
general/ios/app_id="ca-app-pub-5907544153918240~2214746125"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="AscendKeep"
run/main_scene="res://scenes/Home.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/app-icon/icon.png"

[autoload]

Meta="*res://scripts/Meta.gd"
Audio="*res://scripts/Audio.gd"
Ads="*res://scripts/Ads.gd"
Purchases="*res://scripts/Purchases.gd"
Firebase="*res://addons/godot-firebase/firebase/firebase.tscn"
Backend="*res://scripts/Backend.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=480
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/godot-firebase/plugin.cfg", "res://addons/http-sse-client/plugin.cfg", "res://addons/GodotGoogleSignIn/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://addons/admob/gdscript/sample/translations/admob_sample.en.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.pt_BR.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.es.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.zh_CN.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.ja.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
